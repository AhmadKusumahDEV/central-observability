# Salin menjadi .env di VPS. File .env tidak boleh di-commit.
COMPOSE_PROJECT_NAME=central-observability
MONITORING_NETWORK=monitoring

# Grafana diakses lewat Cloudflare Tunnel menuju Nginx internal.
GRAFANA_ROOT_URL=https://observability.madgo.my.id

# Profil Caddy tidak dipakai saat Nginx menjadi edge.
OTEL_DOMAIN=observability.madgo.my.id
ACME_EMAIL=ops@madgo.my.id
OTLP_BASIC_USER=unused-caddy-profile
OTLP_BASIC_HASH='unused-caddy-profile'
