# Endpoint Collector yang terlihat dari container aplikasi.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# grpc untuk port 4317 atau http/protobuf untuk port 4318.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Aktifkan exporter untuk setiap sinyal.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Nama stabil aplikasi. Jangan menambahkan nama environment atau versi.
OTEL_SERVICE_NAME=chat-api

# Pisahkan atribut dengan koma tanpa spasi.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=acme,service.version=1.4.2

# Nilai untuk contoh aplikasi. Ganti saat membuat service sendiri.
DEPLOYMENT_ENVIRONMENT=dev
SERVICE_VERSION=0.1.0

# Untuk TLS remote dengan Caddy, gunakan endpoint HTTPS seperti ini.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:443

# Header Basic auth harus URL-decoded dengan benar oleh SDK.
# Contoh ini adalah otel-writer:password-anda dalam base64 yang sudah di-encode.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic%20b3RlbC13cml0ZXI6cGFzc3dvcmQtYW5kYQ%3D%3D

# Kompresi payload OTLP yang didukung exporter.
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Batas waktu satu ekspor dalam milidetik.
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Propagator untuk melanjutkan trace antar-service.
OTEL_PROPAGATORS=tracecontext,baggage

# Sampling trace. Gunakan rasio rendah untuk trafik produksi besar.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10

# Interval export metrics dalam milidetik.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Nonaktifkan SDK saat aplikasi berjalan tanpa telemetry.
OTEL_SDK_DISABLED=false

# Nama network Docker bersama dengan stack pusat.
MONITORING_NETWORK=monitoring

