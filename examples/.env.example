# Endpoint Collector yang terlihat dari container aplikasi.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# grpc untuk port 4317 atau http/protobuf untuk port 4318.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Aktifkan exporter untuk setiap sinyal.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Nama stabil aplikasi. Jangan menambahkan nama environment atau versi.
OTEL_SERVICE_NAME=chat-api

# Pisahkan atribut dengan koma tanpa spasi.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=acme,service.version=1.4.2

# Untuk TLS remote dengan Caddy, gunakan endpoint HTTPS dan header ini.
# Nilai Basic harus URL-encoded setelah dibentuk.
OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic%20BASE64_URLENCODED_CREDENTIALS

# Kompresi payload OTLP yang didukung exporter.
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Batas waktu satu ekspor dalam milidetik.
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Propagator untuk melanjutkan trace antar-service.
OTEL_PROPAGATORS=tracecontext,baggage

# Nonaktifkan SDK saat aplikasi berjalan tanpa telemetry.
OTEL_SDK_DISABLED=false

# Nama network Docker bersama dengan stack pusat.
MONITORING_NETWORK=monitoring

