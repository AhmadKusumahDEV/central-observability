COMPOSE_PROJECT_NAME=central-observability
MONITORING_NETWORK=monitoring
GRAFANA_ROOT_URL=http://localhost:3000

# Only needed for the optional Caddy ingress profile.
OTEL_DOMAIN=otel.example.com
ACME_EMAIL=ops@example.com
OTLP_BASIC_USER=otel-writer
# Generate interactively: docker run --rm -it caddy:2.11.7 caddy hash-password
# In .env, wrap the bcrypt hash in single quotes so Compose keeps every $ character.
OTLP_BASIC_HASH='replace-with-a-bcrypt-hash'

