# Collector dari container aplikasi. Port 4318 adalah OTLP/HTTP.
# PHP tidak butuh ekstensi grpc untuk jalur ini, jadi http/protobuf paling aman.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Nama stabil service. Jangan menambahkan environment atau versi di sini.
OTEL_SERVICE_NAME=example-php-service

# Pisahkan atribut dengan koma tanpa spasi.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=examples,service.version=0.1.0

# Kirim metrics tiap 10 detik supaya heartbeat tetap segar.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Level log minimum: DEBUG, INFO, WARNING, ERROR.
OTEL_LOG_LEVEL=INFO

OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Dari mesin lain, pakai endpoint publik dan header Basic auth:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.madgo.my.id
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64_USER_PASSWORD

# Alamat aplikasi contoh.
APP_PORT=8080
