# Alamat Collector dari dalam container aplikasi. Port 4317 adalah OTLP gRPC.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Nama stabil service. Ganti hanya nilai ini untuk project baru.
OTEL_SERVICE_NAME=example-go-service

# Pisahkan atribut dengan koma tanpa spasi. Jangan menaruh environment di
# service.name; environment punya tempatnya sendiri.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=examples,service.version=0.1.0

# 1 berarti semua trace disimpan. Turunkan nilainya untuk trafik produksi yang
# besar, misalnya 0.10 untuk sekitar 10 persen trace.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

# Interval pengiriman metrics dalam milidetik.
OTEL_METRIC_EXPORT_INTERVAL=10000

# gzip mengurangi bandwidth. Collector pusat menerima kompresi ini.
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Level log aplikasi: debug, info, warn, atau error.
OBSERVABILITY_LOG_LEVEL=info

# Heartbeat untuk alert service down. Jangan lebih dari 15 detik.
OBSERVABILITY_HEARTBEAT_INTERVAL=15

# Alamat HTTP aplikasi dan URL tujuan span HTTP keluar.
APP_ADDR=:8080
DOWNSTREAM_URL=http://127.0.0.1:8080/downstream
