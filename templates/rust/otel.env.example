# Collector dari container aplikasi. Port 4317 adalah OTLP gRPC.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Nama stabil service. Jangan menambahkan environment atau versi di sini.
OTEL_SERVICE_NAME=example-rust-service

# Pisahkan atribut dengan koma tanpa spasi.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev,service.namespace=examples,service.version=0.1.0

# Kirim metrics tiap 10 detik supaya heartbeat tetap segar.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Level log: trace, debug, info, warn, error, atau direktif EnvFilter.
OTEL_LOG_LEVEL=info

OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Dari mesin lain, pakai OTLP/HTTP dan header Basic auth:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.madgo.my.id
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64_USER_PASSWORD
